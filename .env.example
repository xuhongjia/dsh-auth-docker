# Optional. Official DeepSeek Models card. Cursor can be configured in the UI.
# DEEPSEEK_API_KEY=
DSH_AUTH_PASSWORD=
DSH_AUTH_SECRET=
DSH_AUTH_BASE_URL=http://localhost:3080
# Behind HTTPS (NAS reverse proxy / Cloudflare, for example https://dsh.example.com):
# DSH_AUTH_BASE_URL=https://dsh.example.com
# DSH_AUTH_SECURE_COOKIES=1
# Container runtime uid/gid. Default 0 runs as root, which owns the whole /data
# mount (recommended on 极空间 / other NAS bind mounts). Set 1000 only to drop
# privileges on a Linux host whose share already matches that uid.
# PUID=0
# PGID=0
