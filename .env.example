DEEPSEEK_API_KEY=
DSH_AUTH_PASSWORD=
DSH_AUTH_SECRET=
DSH_AUTH_BASE_URL=http://localhost:3080
# Behind HTTPS (for example https://dsh.example.com):
# DSH_AUTH_BASE_URL=https://dsh.example.com
# DSH_AUTH_SECURE_COOKIES=1
# Container runtime uid/gid. Default 0 runs as root, which owns the whole /data
# mount. Set 1000 (image `node` user) or your host user to drop privileges.
# PUID=1000
# PGID=1000
