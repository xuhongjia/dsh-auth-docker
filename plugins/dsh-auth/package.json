{
  "name": "dsh-auth",
  "version": "0.0.14",
  "description": "Better Auth reverse-proxy bundle for official DeepSeek Harness Web",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc",
    "prepare": "tsc",
    "test": "vitest run"
  },
  "engines": {
    "node": "^22.19 || >=24"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuhongjia/dsh-auth-docker.git"
  },
  "dependencies": {
    "better-auth": "^1.7.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.2",
    "vitest": "^3.2.4"
  }
}
